# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=veiltalk
DB_USER=veiltalk_user
DB_PASSWORD=<strong-password>

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
# Generate with: openssl rand -hex 32
JWT_SECRET=<random-256-bit-hex>
JWT_ACCESS_EXPIRY=900
JWT_REFRESH_EXPIRY=604800

# MinIO
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=<minio-access-key>
MINIO_SECRET_KEY=<minio-secret-key>
MINIO_BUCKET=veiltalk
MINIO_WEBHOOK_SECRET=<hmac-secret>

# Video
VIDEO_STORAGE_LIMIT_BYTES=2147483648  # Hạn mức quota mỗi tài khoản, mặc định 2GB (NFR-19)
VIDEO_LOCK_TTL_MILLIS=30000
VIDEO_LOCK_ACQUIRE_TIMEOUT_MILLIS=5000
VIDEO_PROCESSING_TIMEOUT_SECONDS=600
VIDEO_CLEANUP_INTERVAL_SECONDS=300

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://app.veiltalk.example.com

# Signaling
SIGNALING_JWT_SECRET=<same-as-JWT_SECRET>
PORT=3000
RATE_LIMIT_MAX=20

# PostgreSQL container
POSTGRES_DB=veiltalk
POSTGRES_USER=veiltalk_user
POSTGRES_PASSWORD=<strong-password>

# MinIO container
MINIO_ROOT_USER=<minio-access-key>
MINIO_ROOT_PASSWORD=<minio-secret-key>
