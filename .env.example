# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=veiltalk
DB_USER=veiltalk_user
VEILTALK_DB_PASSWORD=<strong-password>

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
# Generate with: openssl rand -hex 32
JWT_SECRET=<random-256-bit-hex>
JWT_ACCESS_EXPIRY=900
JWT_REFRESH_EXPIRY=604800

# Authentication abuse limits (production defaults)
AUTH_LOGIN_PAIR_LIMIT=5
AUTH_LOGIN_IP_LIMIT=30
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_REGISTER_SUCCESS_LIMIT=5
AUTH_REGISTER_FAILURE_LIMIT=30
AUTH_REGISTER_WINDOW_SECONDS=3600
# Only list proxy source IPs that overwrite X-Forwarded-For; empty means ignore it.
AUTH_TRUSTED_PROXY_IPS=
MESSAGING_WS_CONTRACT_VIOLATION_LIMIT=3
MESSAGING_WS_CONTRACT_VIOLATION_WINDOW_SECONDS=60
MESSAGING_WS_CONNECTION_IP_LIMIT=20
MESSAGING_WS_CONNECTION_USER_LIMIT=5
MESSAGING_WS_CONNECTION_WINDOW_SECONDS=60
MESSAGING_WS_CONNECTION_LEASE_SECONDS=120

# Generate each internal shared secret independently with: openssl rand -hex 32
INTERNAL_CALL_NOTIFY_SECRET=<random-256-bit-hex>

# MinIO
MINIO_ENDPOINT=http://localhost:9000
# Public HTTPS origin used only for presigned browser URLs in production.
MINIO_PUBLIC_ENDPOINT=
MINIO_ACCESS_KEY=<minio-access-key>
MINIO_SECRET_KEY=<minio-secret-key>
MINIO_BUCKET=veiltalk
MINIO_WEBHOOK_SECRET=<another-random-256-bit-hex>

# Video
# Hạn mức quota mỗi tài khoản, mặc định 2GB (NFR-19)
VIDEO_STORAGE_LIMIT_BYTES=2147483648
VIDEO_ACTIVE_UPLOAD_LIMIT=3
VIDEO_FFPROBE_PATH=ffprobe
VIDEO_FFPROBE_TIMEOUT_SECONDS=30
VIDEO_VIEW_URL_EXPIRY_SECONDS=3600
VIDEO_UPLOAD_SESSION_TTL_SECONDS=86400
VIDEO_RECORDING_CLEANUP_INTERVAL_SECONDS=3600
VIDEO_LOCK_TTL_MILLIS=30000
VIDEO_LOCK_ACQUIRE_TIMEOUT_MILLIS=5000
VIDEO_PROCESSING_TIMEOUT_SECONDS=600
VIDEO_CLEANUP_INTERVAL_SECONDS=300

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://app.veiltalk.example.com
# Public DNS name for docker-compose.production.yml and its TLS certificate.
PUBLIC_HOST=app.veiltalk.example.com

# Signaling
SIGNALING_JWT_SECRET=<same-as-JWT_SECRET>
PORT=3000
RATE_LIMIT_MAX=20

# PostgreSQL container
POSTGRES_DB=veiltalk
POSTGRES_USER=veiltalk_user
POSTGRES_PASSWORD=<strong-password>

# MinIO container
MINIO_ROOT_USER=<minio-access-key>
MINIO_ROOT_PASSWORD=<minio-secret-key>
