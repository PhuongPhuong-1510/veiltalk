log_format veiltalk_https_safe '$remote_addr [$time_iso8601] "$request_method $uri" $status $body_bytes_sent';
error_log /dev/stderr crit;

server {
    listen 80;
    server_name ${PUBLIC_HOST};
    access_log /dev/stdout veiltalk_https_safe;
    return 308 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${PUBLIC_HOST};
    access_log /dev/stdout veiltalk_https_safe;
    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Embedder-Policy "require-corp" always;

    location ^~ /internal/ { return 404; }
    location = /internal { return 404; }
    location ^~ /actuator/ { return 404; }
    location = /actuator { return 404; }

    location = /ws/signaling {
        proxy_pass http://signaling:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 75s;
    }

    location = /ws/messaging {
        proxy_pass http://backend:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 75s;
    }

    # Presigned MinIO URLs use the public origin and retain their signed path and Host.
    location ^~ /${MINIO_BUCKET}/ {
        proxy_pass http://minio:9000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_request_buffering off;
        client_max_body_size 0;
    }

    location ~ ^/(auth|users|avatars|conversations|videos|metrics)(/|$) {
        proxy_pass http://backend:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }

    location / {
        proxy_pass http://frontend:5173;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }
}
